fn r @sum (n:i8) (answer:i8) () () ()
^entry():
zero = const.i8 0
one = const.i8 1
br ^loop(n, zero)
^loop(i:i8, acc:i8):
p = icmp.eq i zero
br p ^done(acc) ^more(i, acc)
^more(ii:i8, aa:i8):
next = sub ii one
s = add aa ii
br ^loop(next, s)
^done(answer:i8):
ret answer
